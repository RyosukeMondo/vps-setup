#!/bin/bash
# docker-build-guard — installed as /usr/local/bin/docker on the production VPS.
#
# The VPS (6 cores, 11 GB, ~100 production containers) must never build images:
# builds there starved every service (swap ~95%). Images are built on a
# workstation, pushed to ghcr.io, and only pulled here. This wrapper sits before
# /usr/bin/docker in PATH and refuses the commands that build:
#   docker build | image build | builder build | buildx build|bake
#   docker compose build | watch, and --build on compose up/create/run
# and makes `docker compose up|create` pass --no-build, so a compose service with
# a missing image fails instead of silently building. `compose run` has no --no-build,
# so it is refused when its service (or a depends_on) has build: and no local image.
# It also refuses `docker buildx history` (2026-10-16: dockerd restarted during it
# and all containers stayed down).
#
# Everything else is passed through unchanged with exec (same argv, stdio, exit code).
# Override for a deliberate one-off: VPS_ALLOW_BUILD=1 docker ...  (logged).
# Tests: ./test.sh   Install: ./install.sh <ssh-host>

REAL="${DOCKER_BUILD_GUARD_REAL:-/usr/bin/docker}"
LOG="${DOCKER_BUILD_GUARD_LOG:-/var/log/docker-build-guard.log}"

log() {
  printf '%s user=%s pid=%s ppid=%s verdict=%s argv=%q\n' \
    "$(date -Is)" "${USER:-?}" "$$" "$PPID" "$1" "${*:2}" >>"$LOG" 2>/dev/null || true
}

refuse() {
  log refused "${ARGV[@]}"
  cat >&2 <<EOF
docker-build-guard: refused on this VPS: $1
  Images are not built here. Build on the workstation and push to GHCR, then pull:
    (workstation) the repo's deploy script, e.g. scripts/deploy.sh or deploy/deploy.sh
  Pattern: zukkey/scripts/lib/ghcr.sh. Guard source: vps-setup/ops/docker-build-guard.
  One-off override (logged): VPS_ALLOW_BUILD=1 docker ...
EOF
  exit 1
}

# `docker compose run` has no --no-build: it builds a service that has a build: section and
# no image. Returns 0 (and sets WOULD_BUILD) when the target service or one of its
# depends_on (unless --no-deps) is such a service. $1 = index of "run" in ARGV.
run_would_build() {
  local r=$1 k svc="" nodeps=0 a
  k=$((r + 1))
  while (( k < ${#ARGV[@]} )); do
    a="${ARGV[k]}"
    case "$a" in
      --no-deps) nodeps=1; k=$((k + 1)) ;;
      --cap-add|--cap-drop|-e|--env|--env-from-file|--entrypoint|-l|--label|--name|-p|--publish|--pull|-u|--user|-v|--volume|-w|--workdir) k=$((k + 2)) ;;
      -*) k=$((k + 1)) ;;
      *) svc="$a"; break ;;
    esac
  done
  [[ -z "$svc" ]] && return 1
  local cfg
  cfg="$("$REAL" "${ARGV[@]:0:r}" config --format json 2>/dev/null)" || return 1
  local candidates
  candidates="$(printf '%s' "$cfg" | python3 -c '
import json, sys
svc, nodeps = sys.argv[1], sys.argv[2] == "1"
c = json.load(sys.stdin); services = c.get("services", {}); project = c.get("name", "")
todo, seen = [svc], []
while todo:
    s = todo.pop()
    if s in seen or s not in services: continue
    seen.append(s)
    if not nodeps: todo.extend(services[s].get("depends_on") or {})
for s in seen:
    d = services[s]
    if "build" in d: print(s, d.get("image") or f"{project}-{s}")
' "$svc" "$nodeps" 2>/dev/null)" || return 1
  local name image
  while read -r name image; do
    [[ -z "$name" ]] && continue
    if ! "$REAL" image inspect "$image" >/dev/null 2>&1; then WOULD_BUILD="$name ($image)"; return 0; fi
  done <<<"$candidates"
  return 1
}

ARGV=("$@")
if [[ "${VPS_ALLOW_BUILD:-}" == "1" ]]; then
  log override "${ARGV[@]}"
  exec "$REAL" "$@"
fi

# Skip docker's global options to find the command. Options taking a value:
# -H/--host -c/--context --config -l/--log-level --tlscacert --tlscert --tlskey
i=0
while (( i < ${#ARGV[@]} )); do
  a="${ARGV[i]}"
  case "$a" in
    -H|--host|-c|--context|--config|-l|--log-level|--tlscacert|--tlscert|--tlskey) i=$((i + 2)) ;;
    -*) i=$((i + 1)) ;;
    *) break ;;
  esac
done
cmd="${ARGV[i]:-}"
sub="${ARGV[i + 1]:-}"

case "$cmd" in
  build) refuse "docker build" ;;
  image|builder) [[ "$sub" == "build" ]] && refuse "docker $cmd build" ;;
  buildx)
    case "$sub" in
      build|b|bake) refuse "docker buildx $sub" ;;
      history) refuse "docker buildx history (crashed dockerd on 2026-10-16)" ;;
    esac ;;
  compose)
    # Skip compose's global options. Options taking a value:
    # -f/--file -p/--project-name --profile --env-file --project-directory --ansi --progress --parallel
    j=$((i + 1))
    while (( j < ${#ARGV[@]} )); do
      a="${ARGV[j]}"
      case "$a" in
        -f|--file|-p|--project-name|--profile|--env-file|--project-directory|--ansi|--progress|--parallel) j=$((j + 2)) ;;
        -*) j=$((j + 1)) ;;
        *) break ;;
      esac
    done
    csub="${ARGV[j]:-}"
    case "$csub" in
      build|watch) refuse "docker compose $csub" ;;
      up|create|run)
        for a in "${ARGV[@]:j+1}"; do
          [[ "$a" == "--" ]] && break
          [[ "$a" == "--build" ]] && refuse "docker compose $csub --build"
        done
        if [[ "$csub" == "run" ]]; then
          run_would_build "$j" && refuse "docker compose run: $WOULD_BUILD has a build: section and no local image, so compose would build it"
        else
          has_no_build=0
          for a in "${ARGV[@]:j+1}"; do [[ "$a" == "--no-build" ]] && has_no_build=1; done
          if (( has_no_build == 0 )); then
            exec "$REAL" "${ARGV[@]:0:j+1}" --no-build "${ARGV[@]:j+1}"
          fi
        fi ;;
    esac ;;
esac

exec "$REAL" "$@"
